#!/bin/bash

WAYBAR_DIR="$HOME/.config/waybar"
shopt -s nullglob

trap "killall waybar" EXIT

while true; do
  waybar -l debug &

  # Recursive inotify watches do not follow symlinks. Keep the directory
  # watch for real files and entry changes, and add each resolved target so
  # changes to symlinked files are also observed.
  CONFIG_FILES=("$WAYBAR_DIR"/*)
  for i in "${!CONFIG_FILES[@]}"; do
    CONFIG_FILES[i]=$(readlink -f -- "${CONFIG_FILES[i]}")
  done

  inotifywait -e create,modify -r "$WAYBAR_DIR" "${CONFIG_FILES[@]}"
  killall waybar
done
